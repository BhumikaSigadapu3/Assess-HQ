# Copy to .env in the project root for Docker Compose:
#   cp .env.docker.example .env

# Required — use long random strings in production
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret

# URL where users open the app in the browser
CLIENT_URL=http://localhost:8080

# Bootstrap admin (seed with: docker compose exec backend npm run seed:admin)
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234

# Optional
OPENAI_API_KEY=
JUDGE0_API_KEY=
REDIS_URL=
COOKIE_SECURE=false

# Optional SMTP (verification & hiring emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# FROM_EMAIL=Assess HQ <noreply@example.com>
