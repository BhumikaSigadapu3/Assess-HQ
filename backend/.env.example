NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api/v1

TRUST_PROXY=false
REDIS_URL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

MONGODB_URI=mongodb://localhost:27017/ai_exam_platform

JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

ADMIN_NAME="Platform Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_admin_password

COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_app_password
SMTP_SECURE=false
FROM_EMAIL="AI Exam Platform <noreply@yourdomain.com>"

# Public Judge0 CE (no API key): https://ce.judge0.com — or RapidAPI: https://judge0-ce.p.rapidapi.com + key below
JUDGE0_BASE_URL=https://ce.judge0.com
# Optional: only when JUDGE0_BASE_URL is a RapidAPI host
# JUDGE0_API_KEY=
